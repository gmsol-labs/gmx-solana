{
  "name": "@gmsol-labs/gmsol-sdk",
  "version": "0.12.0",
  "scripts": {
    "build": "rimraf dist pkg && webpack --mode production",
    "start": "rimraf dist pkg && webpack serve",
    "test": "cargo test --features js && wasm-pack test --chrome --features js",
    "test:node": "wasm-pack build --target nodejs --out-dir pkg-node --features js && node --test tests/node/*.test.mjs"
  },
  "devDependencies": {
    "@wasm-tool/wasm-pack-plugin": "1.7.0",
    "html-webpack-plugin": "^5.6.3",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "viem": "^2.58.8",
    "webpack": "^5.107.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "files": [
    "pkg"
  ]
}
